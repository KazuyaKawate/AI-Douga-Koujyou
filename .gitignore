# 一時ファイル
temp/
*.tmp
*.temp

# キャッシュ
__pycache__/
*.pyc
*.pyo
.cache/
.DS_Store
Thumbs.db

# 認証情報・設定ファイル（実値）
config/*.env
config/*.key
config/secrets.*
.env
.env.*
!.env.example

# Google Sheets 認証情報 — 絶対にコミットしないでください
# credentials/ フォルダ内のJSONファイルはすべて除外（.gitkeepのみ追跡）
credentials/
!credentials/.gitkeep
# ローカル専用サービスアカウントファイル（明示的除外）
credentials/service-account.local.json
secrets/
*.service-account.json
*service_account*.json
*oauth*.json
token.json

# 大容量メディアファイル（必要に応じてコメント解除）
# videos/
# voices/
# images/
# output/

# 素材ライブラリ — メディアファイルはローカルのみ、フォルダ構造は .gitkeep で管理
# (case-insensitive on Windows; patterns cover both lower and upper-case extensions)
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.png
assets/**/*.gif
assets/**/*.webp
assets/**/*.bmp
assets/**/*.psd
assets/**/*.mp4
assets/**/*.mov
assets/**/*.avi
assets/**/*.webm
assets/**/*.mp3
assets/**/*.wav
assets/**/*.ogg
assets/**/*.m4a
assets/**/*.aac
assets/**/*.flac

# プロジェクト生成ファイル（大容量になりうる）
project/

# OS・エディタ
.DS_Store
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ログ
*.log
logs/

# AIOS runtime/generated state
data/
output/
release/
config/business_engine.json
config/export_manager.json
config/devstudio_meetings.json

# Node.js（スクリプトでnpmを使う場合）
node_modules/
npm-debug.log*

# Python仮想環境（スクリプトでPythonを使う場合）
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Streamlit
.streamlit/secrets.toml

# Whisper モデルキャッシュ
*.pt

# バックアップ（ローカルのみ）
backups/
!backups/.gitkeep

# Claude Code ローカルメモリ（コミット不要）
.claude/

# ローカル専用ランタイム設定（auth_mode / 認証パス / spreadsheet_id を上書き）
# 絶対にコミットしないでください — credentials が入る場合があります
config/workspace_local.json

# 開発確認用スクリーンショット（大容量になる可能性あり、ローカルのみ）
screenshots/dev/*.png
screenshots/dev/*.jpg

# Project Snapshot 履歴（大量になる可能性あり、ローカルのみ）
# latest.json はコミット対象（AI引き継ぎ用）
snapshots/history/

# AI Router — APIキーはworkspace_local.jsonのai_keysセクションで管理（同ファイルはgitignore済み）
# 万一スタンドアロンファイルを作成した場合の除外
config/ai_keys.json
config/ai_keys.*.json
