# AI動画工場 — Environment Variables
# Copy this file to .env and fill in your values.
# .env is excluded from git — never commit secrets.

# ── AI providers ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── App environment ─────────────────────────────────────────────────────────────
APP_ENV=development

# ── AIOS local-first safety defaults ───────────────────────────────────────────
AIOS_EXTERNAL_APIS_ENABLED=false
AIOS_SCHEDULER_ENABLED=false
AIOS_GOOGLE_AUTH_MODE=disabled
AIOS_DEFAULT_PROVIDER=virtual

# ── Optional external adapters, all disabled by default ────────────────────────
AIOS_PUBLISHING_ADAPTERS_ENABLED=false
AIOS_AFFILIATE_ADAPTERS_ENABLED=false
AIOS_SEO_PROVIDERS_ENABLED=false
